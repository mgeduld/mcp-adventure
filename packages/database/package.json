{
  "name": "@mcp-adventure/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node --import tsx scripts/migrate.ts",
    "status": "node --import tsx scripts/migrate.ts --status",
    "seed": "node --import tsx scripts/seed.ts",
    "wait": "node --import tsx scripts/wait.ts",
    "reset-schema": "node --import tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "try:get-game": "node --import tsx scripts/try-get-game.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
